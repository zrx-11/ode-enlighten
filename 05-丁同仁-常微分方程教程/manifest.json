  "glossary": [
    {
      "term": "常微分方程",
      "def": "一元未知函数及其导数构成的方程",
      "chapterId": "ch01"
    },
    {
      "term": "阶",
      "def": "方程中出现的最高阶导数阶数",
      "chapterId": "ch01"
    },
    {
      "term": "积分曲线",
      "def": "一阶方程的解在平面上的曲线",
      "chapterId": "ch01"
    },
    {
      "term": "线素场",
      "def": "每点标出斜率的短线集合",
      "chapterId": "ch01"
    },
    {
      "term": "等斜线",
      "def": "斜率相同的点连成的线",
      "chapterId": "ch01"
    },
    {
      "term": "恰当方程",
      "def": "左端为全微分的方程",
      "chapterId": "ch02"
    },
    {
      "term": "积分因子",
      "def": "使方程变为恰当方程的乘子",
      "chapterId": "ch02"
    },
    {
      "term": "平移型方程",
      "def": "y′=f(ax+by+c) 型",
      "chapterId": "ch02"
    },
    {
      "term": "齐次型方程",
      "def": "y′=φ(y/x) 型",
      "chapterId": "ch02"
    },
    {
      "term": "隐式方程",
      "def": "未解出导数的方程",
      "chapterId": "ch04"
    },
    {
      "term": "奇解",
      "def": "与通解族相切且不在族内的解",
      "chapterId": "ch04"
    },
    {
