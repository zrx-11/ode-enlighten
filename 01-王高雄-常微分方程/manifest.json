  "glossary": [
    {
      "term": "常微分方程",
      "def": "只含一个自变量、未知函数及其导数的方程",
      "chapterId": "ch01"
    },
    {
      "term": "阶",
      "def": "方程中出现过的最高阶导数的阶数",
      "chapterId": "ch01"
    },
    {
      "term": "线性方程",
      "def": "关于未知函数及其各阶导数都是一次的方程",
      "chapterId": "ch01"
    },
    {
      "term": "通解",
      "def": "含 n 个独立任意常数的解族",
      "chapterId": "ch01"
    },
    {
      "term": "特解",
      "def": "满足给定初值条件的解",
      "chapterId": "ch01"
    },
    {
      "term": "隐式解",
      "def": "由 Φ(x,y)=0 确定的解，也叫积分",
      "chapterId": "ch01"
    },
    {
      "term": "初值问题",
      "def": "方程连同一点处的一组初值条件",
      "chapterId": "ch01"
    },
    {
      "term": "积分曲线",
      "def": "解在平面上的图形",
      "chapterId": "ch01"
    },
    {
      "term": "方向场",
      "def": "平面上每点标出斜率的线素集合",
      "chapterId": "ch01"
    },
    {
      "term": "等斜线",
      "def": "方向场中斜率相同的点的连线",
      "chapterId": "ch01"
    },
    {
      "term": "相平面",
      "def": "以状态变量为坐标的平面，轨线在其上",
      "chapterId": "ch01"
    },
    {
      "term": "变量分离",
      "def": "把方程改写成 f(y)dy=g(x)dx 的方法",
      "chapterId": "ch02"
    },
    {
      "term": "齐次型方程",
      "def": "右端只依赖 y/x 的方程",
      "chapterId": "ch02"
    },
    {
      "term": "常数变易法",
      "def": "把齐次解的常数换成函数求非齐次解",
      "chapterId": "ch02"
    },
    {
      "term": "恰当方程",
      "def": "左端恰为某个函数全微分的方程",
      "chapterId": "ch02"
    },
    {
      "term": "积分因子",
      "def": "乘上去使方程变恰当的因子 μ",
      "chapterId": "ch02"
    },
    {
      "term": "奇解",
      "def": "不属于通解族、但与族中曲线相切的解",
      "chapterId": "ch02"
    },
    {
      "term": "包络",
      "def": "与一族曲线相切的曲线",
      "chapterId": "ch02"
    },
    {
      "term": "李普希茨条件",
      "def": "关于 y 的变化率被常数 L 卡住",
      "chapterId": "ch03"
    },
    {
      "term": "皮卡迭代",
      "def": "用积分方程反复代换逼近解",
      "chapterId": "ch03"
    },
    {
      "term": "格朗沃尔引理",
      "def": "积分不等式推出差为零的工具",
      "chapterId": "ch03"
    },
    {
      "term": "饱和解",
      "def": "不能再延拓的解",
      "chapterId": "ch03"
    },
    {
      "term": "朗斯基行列式",
      "def": "n 个解及其导数排成的行列式",
      "chapterId": "ch04"
    },
    {
      "term": "基本解组",
      "def": "n 个线性无关的齐次解",
      "chapterId": "ch04"
    },
    {
      "term": "特征方程",
      "def": "常系数方程代入 e^(rx) 得到的多项式方程",
      "chapterId": "ch04"
    },
    {
      "term": "基解矩阵",
      "def": "以 n 个线性无关解为列的矩阵 Φ",
      "chapterId": "ch05"
    },
    {
      "term": "矩阵指数",
      "def": "e^(At)=ΣAᵏtᵏ/k!",
      "chapterId": "ch05"
    },
    {
      "term": "预解矩阵",
      "def": "(sI−A)⁻¹，其逆变换为 e^(At)",
      "chapterId": "ch05"
    },
    {
      "term": "平衡点",
      "def": "使 f(x)=0 的点",
      "chapterId": "ch06"
    },
    {
      "term": "渐近稳定",
      "def": "稳定且轨线趋于平衡点",
      "chapterId": "ch06"
    },
    {
      "term": "李雅普诺夫函数",
      "def": "沿轨线单调下降的正定函数 V",
      "chapterId": "ch06"
    },
    {
      "term": "极限环",
      "def": "孤立的闭轨",
      "chapterId": "ch06"
    },
    {
      "term": "哈密顿方程",
      "def": "dp/dt=−H_q，dq/dt=H_p 形式的系统",
      "chapterId": "ch06"
    },
    {
      "term": "首次积分",
      "def": "沿轨线取常数的函数",
      "chapterId": "ch06"
    },
    {
      "term": "特征线",
      "def": "偏微分方程沿之降为常微分方程的曲线",
      "chapterId": "ch07"
    },
    {
      "term": "柯西问题",
      "def": "偏微分方程加初始曲线的问题",
      "chapterId": "ch07"
    },
    {
      "term": "格林函数",
      "def": "点源在边界条件下产生的响应",
      "chapterId": "ch08"
    },
    {
      "term": "斯特姆-刘维尔问题",
      "def": "自伴形式的特征值问题",
      "chapterId": "ch08"
    },
    {
      "term": "弗雷德霍姆二择一",
      "def": "齐次问题只有零解则非齐次唯一可解",
      "chapterId": "ch08"
    }
  ],
