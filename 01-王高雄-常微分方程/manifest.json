  "quizzes": [
    {
      "id": "q01",
      "chapterId": "ch01",
      "type": "single",
      "question": "y·y″+(y′)²=0 的阶数与线性性是？",
      "options": [
        "二阶，线性",
        "二阶，非线性",
        "一阶，非线性",
        "三阶，非线性"
      ],
      "answer": 1,
      "explain": "含 y·y″ 使方程关于 y 及其导数为二次，故非线性。"
    },
    {
      "id": "q02",
      "chapterId": "ch01",
      "type": "single",
      "question": "一阶方程 y′=f(x,y) 的等斜线 f(x,y)=0 处，积分曲线的切线是？",
      "options": [
        "竖直的",
        "水平的",
        "斜率为 1",
        "不存在"
      ],
      "answer": 1,
      "explain": "斜率为零即切线水平。"
    },
    {
      "id": "q03",
      "chapterId": "ch01",
      "type": "single",
      "question": "n 阶方程通解中 n 个常数强调“独立”，判据是？",
      "options": [
        "常数互不相等",
        "对常数的雅可比行列式不为零",
        "常数可以取任意值",
        "常数个数等于阶数"
      ],
      "answer": 1,
      "explain": "独立性用雅可比行列式不为零定义，防止常数相互替代造成自由度退化。"
    },
    {
      "id": "q04",
      "chapterId": "ch02",
      "type": "single",
      "question": "解 dy/dx=y² 时，除通解 y=−1/(x+C) 外还必须单独记录的解是？",
      "options": [
        "y=1",
        "y=0",
        "y=x",
        "没有额外解"
      ],
      "answer": 1,
      "explain": "分离变量时除以 y²，y≡0 是常数解，必须单独写。"
    },
    {
      "id": "q05",
      "chapterId": "ch02",
      "type": "single",
      "question": "(2xy+y²)dx+(x²+2xy)dy=0 是恰当方程，其解为？",
      "options": [
        "x²y+xy²=C",
        "x²+y²=C",
        "xy=C",
        "x²y²=C"
      ],
      "answer": 0,
      "explain": "取 u=x²y+xy²，du 恰为左端。"
    },
    {
      "id": "q06",
      "chapterId": "ch02",
      "type": "single",
      "question": "一阶线性方程 y′+P(x)y=Q(x) 的通解公式是？",
      "options": [
        "y=Ce^(−∫P)",
        "y=e^(−∫P)[∫Qe^(∫P)dx+C]",
        "y=e^(∫P)[∫Qe^(−∫P)dx+C]",
        "y=∫Qdx+C"
      ],
      "answer": 1,
      "explain": "常数变易法得到的标准公式。"
    },
    {
      "id": "q07",
      "chapterId": "ch03",
      "type": "single",
      "question": "皮卡定理中 h=min(a,b/M) 的 M 指？",
      "options": [
        "李普希茨常数",
        "|f| 在矩形上的最大值",
        "矩形的宽",
        "初值的模"
      ],
      "answer": 1,
      "explain": "M 是 f 在矩形上的最大模，用来保证迭代不跑出矩形。"
    },
    {
      "id": "q08",
      "chapterId": "ch03",
      "type": "single",
      "question": "唯一性证明中格朗沃尔引理的 A 取？",
      "options": [
        "A=1",
        "A=0",
        "A=M",
        "A=L"
      ],
      "answer": 1,
      "explain": "两个解之差在初值点为 0，故 A=0，从而差恒为零。"
    },
    {
      "id": "q09",
      "chapterId": "ch03",
      "type": "single",
      "question": "方程 y′=3y^(2/3)，y(0)=0 的解的特点是？",
      "options": [
        "唯一",
        "不存在",
        "不唯一",
        "只在正半轴存在"
      ],
      "answer": 2,
      "explain": "f 在 y=0 处不满足李普希茨，解不唯一：y≡0 与 y=x³ 都是解。"
